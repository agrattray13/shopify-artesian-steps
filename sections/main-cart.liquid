<div class="page-width section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="cart">
    <h1 class="title title--primary cart__title">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="cart__empty-text">
        <p>{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'sections.cart.continue_browsing' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" class="cart__contents" method="post" id="cart">
        <div class="cart__items" id="main-cart-items">
          <div class="js-contents">
            {%- for item in cart.items -%}
              <div class="cart-item" id="CartItem-{{ item.index | plus: 1 }}">
                <div class="cart-item__media">
                  {%- if item.image -%}
                    <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true">
                      {{ item.image | image_url: width: 300 | image_tag:
                        class: 'cart-item__image',
                        widths: '165, 360, 533',
                        loading: 'lazy',
                        width: item.image.width,
                        height: item.image.height
                      }}
                    </a>
                  {%- endif -%}
                </div>

                <div class="cart-item__details">
                  {%- if section.settings.show_vendor -%}
                    <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                  {%- endif -%}

                  <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                  {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != nil -%}
                    <dl>
                      {%- if item.product.has_only_default_variant == false -%}
                        {%- for option in item.options_with_values -%}
                          <div class="product-option">
                            <dt>{{ option.name }}: </dt>
                            <dd class="truncate">{{ option.value }}</dd>
                          </div>
                        {%- endfor -%}
                      {%- endif -%}
                    </dl>
                  {%- endif -%}

                  <div class="cart-item__quantity-wrapper">
                    {%- render 'quantity-input', section_id: section.id, item: item -%}
                    <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert"></div>
                  </div>
                </div>

                <div class="cart-item__totals right">
                  <div class="cart-remove-button" id="Remove-{{ item.index | plus: 1 }}">
                    <a href="{{ item.url_to_remove }}" class="button button--tertiary" aria-label="{{ 'sections.cart.remove' | t }}">
                      Remove
                    </a>
                  </div>
                  <div class="cart-item__price-wrapper">
                    {%- render 'price', product: item.product, use_variant: true, show_badges: false -%}
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="cart__footer" id="main-cart-footer">
          <div class="cart__blocks">
            {%- if section.settings.show_cart_note -%}
              <cart-note class="cart__note field">
                <label for="CartSpecialInstructions">{{ 'sections.cart.note' | t }}</label>
                <textarea class="text-area field__input" name="note" form="cart" id="CartSpecialInstructions" placeholder="{{ 'sections.cart.note' | t }}">{{ cart.note }}</textarea>
              </cart-note>
            {%- endif -%}

            <div class="cart__footer-subtotal js-contents">
              <div class="totals">
                <h2 class="totals__subtotal">{{ 'sections.cart.subtotal' | t }}</h2>
                <p class="totals__subtotal-value">{{ cart.total_price | money_with_currency }}</p>
              </div>
              <small class="tax-note caption-large rte">
                {{- 'sections.cart.taxes_and_shipping_policy' | t -}}
              </small>
            </div>
            <div class="cart__ctas">
              <button type="submit" id="checkout" class="cart__checkout-button btn btn--primary btn--full-width" name="checkout" form="cart">
                {{ 'sections.cart.checkout' | t }}
              </button>
            </div>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart",
  "class": "cart-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show product vendor"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "default": false,
      "label": "Enable cart note"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "select",
      "id": "color_scheme_2",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-2",
      "label": "Summary color scheme"
    }
  ]
}
{% endschema %}
