{%- if section.settings.title != blank or section.settings.description != blank or section.settings.show_view_all and section.settings.view_all_style == 'link' and collection.all_products_count > section.settings.products_to_show -%}
  <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin page-width{% if settings.animations_reveal_on_scroll == 'enabled' %} scroll-trigger animate--slide-in{% endif %}">
    <div class="title-wrapper">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="collection-description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.show_view_all and section.settings.view_all_style == 'link' and collection.all_products_count > section.settings.products_to_show -%}
      <a href="{{ collection.url }}" class="link underlined-link large-up-hide">{{ 'sections.featured_collection.view_all' | t }}</a>
    {%- endif -%}
  </div>
{%- endif -%}

{%- liquid
  assign products_to_show = section.settings.products_to_show
  if section.settings.collection == blank
    assign featured_collection = collections['all']
  else
    assign featured_collection = collections[section.settings.collection]
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <ul class="grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop page-width" role="list">
    {%- for product in featured_collection.products limit: products_to_show -%}
      <li class="grid__item{% if settings.animations_reveal_on_scroll == 'enabled' %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll == 'enabled' %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}>
        {%- render 'product-card', product_ref: product, media_aspect_ratio: section.settings.image_ratio, show_secondary_image: section.settings.show_secondary_image, show_vendor: section.settings.show_vendor, show_rating: section.settings.show_rating -%}
      </li>
    {%- else -%}
      {%- for i in (1..products_to_show) -%}
        <li class="grid__item">
          {%- render 'product-card', show_vendor: section.settings.show_vendor -%}
        </li>
      {%- endfor -%}
    {%- endfor -%}
  </ul>
</div>

{%- if section.settings.show_view_all and section.settings.view_all_style == 'button' and collection.all_products_count > section.settings.products_to_show -%}
  <div class="center collection-view-all page-width{% if settings.animations_reveal_on_scroll == 'enabled' %} scroll-trigger animate--slide-in{% endif %}">
    <a href="{{ featured_collection.url }}" class="btn btn--secondary btn--medium">
      {{- 'sections.featured_collection.view_all' | t -}}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Featured collection",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 25,
      "step": 1,
      "default": 4,
      "label": "Maximum products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "Enable \"View all\" button"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "options": [
        { "value": "link", "label": "Link" },
        { "value": "outline", "label": "Outline button" },
        { "value": "solid", "label": "Solid button" }
      ],
      "default": "solid",
      "label": "\"View all\" style"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_slider",
      "default": false,
      "label": "Enable slider on desktop"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Number of columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show second image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show product vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
