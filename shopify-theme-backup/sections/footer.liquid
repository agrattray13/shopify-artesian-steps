<footer class="footer color-{{ section.settings.color_scheme }} gradient" role="contentinfo">
  <div class="footer__content-top page-width">

    {%- if section.blocks.size > 0 -%}
      <div class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet">
        {%- for block in section.blocks -%}
          <div class="footer-block grid__item footer-block--{{ block.type }}" {{ block.shopify_attributes }}>

            {%- case block.type -%}
              {%- when 'link_list' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer-block__heading inline-richtext">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer-block__details-content list-unstyled" role="list">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li>
                        <a href="{{ link.url }}" class="link link--text list-menu__item list-menu__item--link{% if link.current %} list-menu__item--active{% endif %}"
                          {% if link.current %}aria-current="page"{% endif %}>
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="footer-block__heading inline-richtext">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <div class="footer-block__subtext rte">{{ block.settings.subtext }}</div>
                {%- endif -%}

              {%- when 'image' -%}
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 300 | image_tag: class: 'footer-block__image', widths: '50, 100, 150, 200, 250, 300' }}
                {%- endif -%}
            {%- endcase -%}

          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.newsletter_enable -%}
      <div class="footer-block footer-block--newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <h3 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h3>
        {%- endif -%}
        {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="newsletter-form__field-wrapper">
            <div class="field">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="field__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="ContactFooter-error"
                {% elsif form.posted_successfully? %}
                  aria-describedby="ContactFooter-success"
                {% endif %}
                placeholder="Email address"
                required
              >
              <label class="field__label" for="NewsletterForm--{{ section.id }}">Email address</label>
            </div>
            <button type="submit" class="newsletter-form__button field__button btn" name="commit" id="Subscribe" aria-label="Subscribe">
              Subscribe
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="ContactFooter-error">
              {{- form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] -}}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <h3 class="newsletter-form__message newsletter-form__message--success form__message" id="ContactFooter-success" tabindex="-1" autofocus>
              Thanks for subscribing!
            </h3>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

  </div>

  <div class="footer__content-bottom page-width">
    <div class="footer__content-bottom-wrapper">
      <div class="footer__column footer__localization">
        {%- render 'localization-form', localPosition: 'FooterColumns' -%}
      </div>
      <div class="footer__column footer__column--info">
        {%- if section.settings.show_social -%}
          <div class="footer__list-social">
            {%- render 'social-icons' -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="footer__copyright caption">
      <small class="copyright__content">&copy; {{ 'now' | date: "%Y" }}, {{ shop.name }}</small>
      <small class="copyright__content">
        {%- unless powered_by_link == blank -%}
          &bull; {{ powered_by_link }}
        {%- endunless -%}
      </small>
      {%- if section.settings.payment_enable -%}
        <div class="footer__payment">
          <span class="visually-hidden">Payment methods</span>
          <ul class="list list-payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "Show email signup"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Subscribe to our emails",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Show social media icons"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Show payment icons"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": "background-2",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Our mission",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Use this section to tell customers about your store.</p>",
          "label": "Subtext"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ]
}
{% endschema %}
