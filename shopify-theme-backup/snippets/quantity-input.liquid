{%- liquid
  if item
    assign quantity = item.quantity
    assign item_id = item.index | plus: 1
    assign item_key = item.key
  else
    assign quantity = 1
    assign item_id = section_id
    assign item_key = product.selected_or_first_available_variant.id
  endif
-%}

<quantity-input class="quantity">
  <button class="quantity__button no-js-hidden" name="minus" type="button">
    <span class="visually-hidden">{{ 'sections.main_product.decrease_quantity' | t: product: product.title }}</span>
    <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-minus" viewBox="0 0 10 2">
      <path fill-rule="evenodd" d="M.5 1C.5.7.7.5 1 .5h8a.5.5 0 110 1H1A.5.5 0 01.5 1z" clip-rule="evenodd"/>
    </svg>
  </button>
  <input
    class="quantity__input"
    type="number"
    name="quantity"
    id="Quantity-{{ item_id }}"
    min="0"
    value="{{ quantity }}"
    form="{{ product_form_id }}"
    {% if item %}data-cart-quantity="{{ item.quantity }}" data-index="{{ item.index | plus: 1 }}"{% endif %}
  >
  <button class="quantity__button no-js-hidden" name="plus" type="button">
    <span class="visually-hidden">{{ 'sections.main_product.increase_quantity' | t: product: product.title }}</span>
    <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-plus" viewBox="0 0 10 10">
      <path fill-rule="evenodd" d="M1 4.51a.5.5 0 000 1h3.5l.01 3.5a.5.5 0 001-.01V5.5l3.5-.01a.5.5 0 00-.01-1 H5.5L5.49.99a.5.5 0 00-1 .01v3.5l-3.5.01H1z" clip-rule="evenodd"/>
    </svg>
  </button>
</quantity-input>
